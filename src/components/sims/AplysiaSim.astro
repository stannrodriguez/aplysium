---
import '../../styles/sim.css';
import '../../styles/sims/aplysia.css';

interface Props {
  label?: string;
}

const { label = 'Aplysia · the gill-withdrawal reflex' } = Astro.props;

// The transmitter cluster and the neurotransmitters in flight are both static
// in the markup — the script sets how many of each show, so the panel already
// reads as a synapse before any script runs.
const vesicleSeed = Array.from({ length: 9 });
const ntSeed = Array.from({ length: 8 });
---

<aplysia-sim class="sim" data-mode="baseline">
  <div class="sim-chrome">
    <span class="sim-chrome-dot" aria-hidden="true"></span>
    <span class="sim-chrome-label">{label}</span>
    <span class="sim-chrome-status" data-sim-status aria-live="polite">untrained</span>
  </div>

  <div class="sim-modes" role="group" aria-label="Choose what to watch">
    <button type="button" class="sim-mode-tab" data-sim-mode="baseline" aria-pressed="true">Baseline</button>
    <button type="button" class="sim-mode-tab" data-sim-mode="hab" aria-pressed="false">Habituation</button>
    <button type="button" class="sim-mode-tab" data-sim-mode="sens" aria-pressed="false">Sensitization</button>
    <button type="button" class="sim-mode-tab" data-sim-mode="insight" aria-pressed="false">Short vs long&#8209;term</button>
  </div>

  <div class="sim-panels">
    <section class="sim-panel">
      <p class="sim-lead" data-sim-lead aria-live="polite">
        A harmless touch fires the sensory neuron, which releases transmitter onto the motor neuron. The gill withdraws. This is the untrained baseline.
      </p>

      {/* ── the experiment: one continuous synapse cross-section ── */}
      <div data-sim-experiment>
        <div class="sim-stage apl-stage">
          <svg
            class="apl-svg"
            viewBox="0 0 600 300"
            xmlns="http://www.w3.org/2000/svg"
            role="img"
            aria-label="A sensory neuron releasing transmitter across a gap onto the motor neuron that pulls the gill in"
            data-sim-svg
          >
            {/* sensory neuron */}
            <rect class="apl-cell" x="38" y="22" width="212" height="52" rx="9"/>
            <text class="apl-cell-name" x="144" y="45" text-anchor="middle">SENSORY NEURON</text>
            <text class="apl-cell-role" x="144" y="63" text-anchor="middle">feels the touch</text>

            {/* interneuron — sensitization only */}
            <g data-sim-inter class="apl-inter">
              <rect class="apl-cell apl-cell-warm" x="352" y="22" width="212" height="52" rx="9"/>
              <text class="apl-cell-name apl-warm-ink" x="458" y="45" text-anchor="middle">INTERNEURON</text>
              <text class="apl-cell-role apl-warm-ink" x="458" y="63" text-anchor="middle">fires on tail shock</text>
              <path class="apl-sero-path" d="M352 66 Q270 96 232 116" fill="none"/>
              <g data-sim-sero>
                {[0, 1, 2].map(i => (
                  <circle class="apl-sero" cx={288 - i * 16} cy={104 + i * 5} r="4"/>
                ))}
              </g>
              <text class="apl-sero-label" x="300" y="128" text-anchor="middle">serotonin</text>
              <path class="apl-shock" data-sim-shockglyph d="M556 92 l-11 21 l9 0 l-9 21" fill="none"/>
              <text class="apl-shock-label" x="552" y="84" text-anchor="middle">tail shock</text>
            </g>

            {/* axon down to the terminal */}
            <line class="apl-axon" x1="144" y1="74" x2="144" y2="126"/>

            {/* transmitter waiting in the terminal */}
            <g data-sim-vesicles>
              {vesicleSeed.map((_, i) => (
                <circle
                  class="apl-vesicle"
                  cx={112 + (i % 3) * 22}
                  cy={104 + Math.floor(i / 3) * 15}
                  r="6"
                />
              ))}
            </g>

            <text class="apl-gap-label" x="250" y="150" text-anchor="start">synaptic gap</text>

            {/* transmitter in flight */}
            <g data-sim-nts>
              {ntSeed.map((_, i) => (
                <circle
                  class="apl-nt"
                  cx={116 + (i % 4) * 18}
                  cy={162 + Math.floor(i / 4) * 12}
                  r="4"
                />
              ))}
            </g>

            {/* motor neuron */}
            <rect class="apl-cell" x="38" y="222" width="212" height="52" rx="9"/>
            <text class="apl-cell-name" x="144" y="245" text-anchor="middle">MOTOR NEURON</text>
            <text class="apl-cell-role" x="144" y="263" text-anchor="middle">pulls the gill in</text>

            {/* the gill, retracting */}
            <g data-sim-gill class="apl-gill-g">
              {[0, 1, 2, 3].map(i => (
                <rect class="apl-gill-bar" x={300 + i * 13} y={222} width="8" height="52" rx="4"/>
              ))}
            </g>
            <text class="apl-gap-label" x="300" y="292" text-anchor="start">gill</text>

            {/* gill-response gauge */}
            <text class="apl-gauge-label" x="352" y="150" text-anchor="start">GILL RESPONSE</text>
            <rect class="apl-gauge-track" x="352" y="160" width="210" height="20" rx="6"/>
            <rect class="apl-gauge-fill" data-sim-respbar x="352" y="160" width="130" height="20" rx="6"/>
          </svg>
        </div>

        <div class="sim-readout apl-metrics">
          <span class="apl-metric"><b data-sim-mStimuli>0</b> stimuli</span>
          <span class="apl-metric"><b data-sim-mRelease>100%</b> transmitter</span>
          <span class="apl-metric"><b data-sim-mResp>64%</b> gill response</span>
        </div>
      </div>

      {/* ── the insight: short-term vs long-term ── */}
      <div data-sim-insight hidden>
        <div class="sim-choices">
          <button type="button" class="sim-choice" data-sim-schedule="massed" aria-pressed="false">
            <b>Massed</b><em>4 sessions back to back</em>
          </button>
          <button type="button" class="sim-choice" data-sim-schedule="spaced" aria-pressed="false">
            <b>Spaced</b><em>4 sessions with rests between</em>
          </button>
        </div>
        <div class="sim-toggle">
          <span class="sim-toggle-label">Protein synthesis</span>
          <button type="button" class="sim-pill" data-sim-protein="intact" aria-pressed="true">intact</button>
          <button type="button" class="sim-pill" data-sim-protein="blocked" aria-pressed="false">blocked</button>
        </div>
        <button type="button" class="sim-run" data-sim-run disabled>pick a schedule first</button>

        <div class="sim-results" data-sim-results hidden>
          <div class="sim-results-pair">
            <div class="sim-metric">
              <p class="sim-metric-label">An hour later</p>
              <div class="sim-meter"><i data-sim-h1></i></div>
              <p class="sim-metric-word" data-sim-h1-word></p>
            </div>
            <div class="sim-metric">
              <p class="sim-metric-label">A day later</p>
              <div class="sim-meter"><i data-sim-h24></i></div>
              <p class="sim-metric-word" data-sim-h24-word></p>
            </div>
          </div>
          <div class="apl-conn">
            <div class="apl-conn-bars" data-sim-conn aria-hidden="true"></div>
            <p class="sim-note" data-sim-conn-note></p>
          </div>
          <p class="sim-verdict" data-sim-verdict></p>
        </div>
      </div>
    </section>
  </div>

  {/* the action bar changes with the mode; the insight mode runs itself */}
  <div class="sim-controls" data-sim-controls></div>
</aplysia-sim>

<script>
  import '../../scripts/sims/aplysia';
</script>
