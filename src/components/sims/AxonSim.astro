---
import '../../styles/sim.css';
import '../../styles/sims/axon.css';

interface Props {
  label?: string;
}

const { label = 'Squid giant axon · voltage recorded' } = Astro.props;
---

<axon-sim class="sim" data-mode="sub">
  <div class="sim-chrome">
    <span class="sim-chrome-dot" aria-hidden="true"></span>
    <span class="sim-chrome-label">{label}</span>
    <span class="sim-chrome-status" data-sim-status aria-live="polite">sub-threshold</span>
  </div>

  <div class="sim-modes" role="group" aria-label="Choose what to watch">
    <button type="button" class="sim-mode-tab" data-sim-mode="sub" aria-pressed="true">Sub&#8209;threshold</button>
    <button type="button" class="sim-mode-tab" data-sim-mode="fire" aria-pressed="false">Fire a spike</button>
    <button type="button" class="sim-mode-tab" data-sim-mode="insight" aria-pressed="false">The two currents</button>
  </div>

  <div class="sim-panels">
    <section class="sim-panel">
      <p class="sim-lead" data-sim-lead aria-live="polite">
        A half-millisecond pulse charges the membrane a little, then it leaks straight back — nothing regenerative. Raise the stimulus and fire to see how close to threshold you can get.
      </p>

      <div class="sim-panel-head">
        <h3 class="sim-panel-title">Membrane potential</h3>
        <p class="sim-readout">peak <b data-sim-peak aria-live="polite">−65.0 mV</b> <span data-sim-status-word>resting</span></p>
      </div>

      <div class="sim-stage hh-stage" data-sim-vplot></div>

      {/* the two currents underneath — insight mode only */}
      <div data-sim-gwrap hidden>
        <div class="sim-panel-head">
          <h3 class="sim-panel-title">The two currents underneath</h3>
        </div>
        <div class="sim-stage hh-stage-g" data-sim-gplot></div>
        <p class="sim-key">
          <span><i style="background:var(--sim-signal)"></i> sodium (fast, then off)</span>
          <span><i style="background:var(--sim-kept)"></i> potassium (slow, holds)</span>
        </p>
      </div>

      {/* stimulus strength — sub-threshold and fire modes */}
      <div class="sim-field" data-sim-ampwrap>
        <span class="sim-field-label" id="hh-amp-label">Stimulus — a half-millisecond pulse</span>
        <input
          class="sim-slider"
          type="range"
          min="0"
          max="30"
          value="8"
          step="1"
          data-sim-amp
          aria-labelledby="hh-amp-label"
        />
        <span class="sim-value" data-sim-amp-value>8 µA/cm²</span>
      </div>

      {/* channel blockers live in the experiment — fire mode only */}
      <div class="sim-toggle" data-sim-blockwrap hidden>
        <span class="sim-toggle-label">Applied to the bath</span>
        <button type="button" class="sim-pill" data-sim-blocker="none" aria-pressed="true">nothing</button>
        <button type="button" class="sim-pill" data-sim-blocker="ttx" aria-pressed="false">tetrodotoxin — blocks Na⁺</button>
        <button type="button" class="sim-pill" data-sim-blocker="tea" aria-pressed="false">TEA — blocks K⁺</button>
      </div>

      <p class="sim-verdict" data-sim-verdict hidden>
        Fire it at two different strengths above threshold and leave both traces on screen.
      </p>
    </section>
  </div>

  {/* the action bar changes with the mode */}
  <div class="sim-controls" data-sim-controls></div>
</axon-sim>

<script>
  import '../../scripts/sims/axon';
</script>
