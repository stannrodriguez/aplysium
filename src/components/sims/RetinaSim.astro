---
import '../../styles/sim.css';
import '../../styles/sims/retina.css';

interface Props {
  label?: string;
}

const { label = 'One retinal ganglion cell · recorded' } = Astro.props;

// The retina patch and the electrode are server-rendered so the panel already
// reads as a slab of retina with a recording spot before any script runs — the
// script only swaps in each mode's flash, raster and map.
---

<retina-sim class="sim" data-mode="centre">
  <div class="sim-chrome">
    <span class="sim-chrome-dot" aria-hidden="true"></span>
    <span class="sim-chrome-label">{label}</span>
    <span class="sim-chrome-status" data-sim-status aria-live="polite">centre drives</span>
  </div>

  <div class="sim-modes" role="group" aria-label="Choose what to watch">
    <button type="button" class="sim-mode-tab" data-sim-mode="centre" aria-pressed="true">Centre spot</button>
    <button type="button" class="sim-mode-tab" data-sim-mode="surround" aria-pressed="false">Surround spot</button>
    <button type="button" class="sim-mode-tab" data-sim-mode="map" aria-pressed="false">Map the field</button>
    <button type="button" class="sim-mode-tab" data-sim-mode="insight" aria-pressed="false">Even flood</button>
  </div>

  <div class="sim-panels">
    <section class="sim-panel">
      <p class="sim-lead" data-sim-lead aria-live="polite">
        A small spot of light on the receptive-field centre. The cell fires hard above its resting
        rate — this is where light drives it.
      </p>

      {/* ── the experiment: a patch of retina, its record, and the map ── */}
      <div data-sim-experiment>
        <div class="sim-panel-head">
          <h3 class="sim-panel-title">The retina</h3>
          <p class="sim-readout">firing <b data-sim-rate aria-live="polite">44 /s</b></p>
        </div>

        <div class="sim-stage rf-stage" data-sim-retina>
          <svg
            class="rf-svg"
            viewBox="0 0 320 200"
            role="img"
            aria-label="A patch of retina with the recording electrode at its centre and a small spot of light on the receptive-field centre."
            data-sim-svg
          >
            <rect class="rf-bg" x="0" y="0" width="320" height="200"/>
            <circle class="rf-spot" cx="160" cy="100" r="11"/>
            <circle class="rf-electrode" cx="160" cy="100" r="3"/>
            <text class="rf-label" x="168" y="104">ELECTRODE</text>
          </svg>
        </div>

        {/* the electrode's own record — hidden in the map view */}
        <div data-sim-recordwrap>
          <div class="sim-panel-head">
            <h3 class="sim-panel-title">What the electrode heard</h3>
            <p class="sim-readout">4 repeats</p>
          </div>
          <div class="sim-stage rf-raster" data-sim-raster></div>
        </div>

        {/* the map — revealed only in the map view */}
        <div data-sim-mapwrap hidden>
          <div class="sim-panel-head">
            <h3 class="sim-panel-title">The map</h3>
          </div>
          <div class="sim-stage rf-map">
            <div data-sim-mapplot></div>
            <p class="rf-map-empty" data-sim-map-empty>
              sweep the small spot over the whole patch to see the shape →
            </p>
          </div>
          <p class="sim-key">
            <span><i style="background:var(--sim-signal)"></i> drives the cell</span>
            <span><i style="background:var(--sim-kept)"></i> suppresses it</span>
            <span><i style="background:var(--meta-faint)"></i> no effect</span>
          </p>
        </div>

        <p class="sim-note" data-sim-retina-note>
          The cell never goes silent — it has a resting rate to be pushed above or below, which is
          what makes suppression something you can measure.
        </p>
      </div>

      {/* ── the insight: flood the whole field and read the difference ── */}
      <div data-sim-insight hidden>
        <div class="sim-panel-head">
          <h3 class="sim-panel-title">The whole field, lit at once</h3>
          <p class="sim-readout">firing <b data-sim-flood-rate>12 /s</b></p>
        </div>

        <div class="sim-stage rf-stage" data-sim-flood-stage>
          <svg
            class="rf-svg"
            viewBox="0 0 320 200"
            role="img"
            aria-label="The whole patch of retina flooded with even light."
            data-sim-flood-svg
          >
            <rect class="rf-bg" x="0" y="0" width="320" height="200"/>
            <rect class="rf-flood" data-sim-flood-fill x="0" y="0" width="320" height="200"/>
            <circle class="rf-electrode" cx="160" cy="100" r="3"/>
            <text class="rf-label" x="168" y="104">ELECTRODE</text>
          </svg>
        </div>

        <div class="rf-cancel" data-sim-cancel>
          <div class="rf-cancel-row">
            <span class="rf-cancel-tag">centre excites</span>
            <div class="rf-cancel-bar"><i class="rf-cancel-up" data-sim-drivebar></i></div>
            <span class="rf-cancel-num rf-cancel-plus" data-sim-drivenum>+138</span>
          </div>
          <div class="rf-cancel-row">
            <span class="rf-cancel-tag">surround inhibits</span>
            <div class="rf-cancel-bar"><i class="rf-cancel-down" data-sim-suppressbar></i></div>
            <span class="rf-cancel-num rf-cancel-minus" data-sim-suppressnum>&#8722;138</span>
          </div>
          <p class="rf-cancel-net">
            difference the cell reports: <b data-sim-net>12 /s</b>, barely off its resting 12 /s
          </p>
        </div>

        <div class="sim-toggle">
          <span class="sim-toggle-label">Turn up the light</span>
          <button type="button" class="sim-pill" data-sim-bright="1" aria-pressed="true">1&#215;</button>
          <button type="button" class="sim-pill" data-sim-bright="2" aria-pressed="false">2&#215;</button>
          <button type="button" class="sim-pill" data-sim-bright="4" aria-pressed="false">4&#215;</button>
        </div>

        <p class="sim-verdict" data-sim-verdict>
          Double the light and both centre and surround double with it; their difference — everything
          the cell sends on — stays put. So the eye reports contrast, where brightness changes, not
          brightness itself. That is the roughly hundred-to-one squeeze into the optic nerve, why a
          face reads the same in sun or lamplight, and why brightness illusions fool you.
        </p>
      </div>
    </section>
  </div>

  {/* the action bar changes with the mode; the insight mode runs itself */}
  <div class="sim-controls" data-sim-controls></div>
</retina-sim>

<script>
  import '../../scripts/sims/retina';
</script>
