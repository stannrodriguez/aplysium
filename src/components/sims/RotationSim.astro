---
import '../../styles/sim.css';
import '../../styles/sims/rotation.css';

interface Props {
  label?: string;
}

const { label = 'Same object, or mirror image?' } = Astro.props;
---

<rotation-sim class="sim" data-mode="experiment">
  <div class="sim-chrome">
    <span class="sim-chrome-dot" aria-hidden="true"></span>
    <span class="sim-chrome-label">{label}</span>
    <span class="sim-chrome-status" data-sim-status aria-live="polite">0 trials</span>
  </div>

  <div class="sim-modes" role="group" aria-label="Choose what to do">
    <button type="button" class="sim-mode-tab" data-sim-mode="experiment" aria-pressed="true">Do the trials</button>
    <button type="button" class="sim-mode-tab" data-sim-mode="insight" aria-pressed="false">Your line</button>
  </div>

  <div class="sim-panels">
    <section class="sim-panel">
      <p class="sim-lead" data-sim-lead aria-live="polite">
        Two block figures, one of them turned. Judge whether they are the same object or mirror images — as
        fast as you can be sure. Your reaction time is what gets recorded.
      </p>

      {/* ── the experiment: same/different, timed on the reader ── */}
      <div data-sim-experiment>
        <div class="sim-stage rot-stage" data-sim-pair>
          <p class="rot-blank">
            Two figures, one turned. Decide whether they are the same object or mirror images — as fast as
            you can be sure. Press “Next pair” to begin.
          </p>
        </div>

        <div class="sim-readout rot-metrics">
          <span>turned <b data-sim-angle>—</b></span>
          <span><b data-sim-count>0</b> trials recorded</span>
        </div>

        <div class="rot-answers">
          <button type="button" class="rot-answer" data-sim-answer="same" disabled>Same object</button>
          <button type="button" class="rot-answer" data-sim-answer="mirror" disabled>Mirror image</button>
        </div>
      </div>

      {/* ── the insight: those reaction times, plotted against angle ── */}
      <div data-sim-insight hidden>
        <div class="sim-stage rot-plot-stage" data-sim-plot></div>

        <p class="sim-key">
          <span><i style="background:var(--sim-signal)"></i> correct</span>
          <span><i style="background:var(--sim-lost)"></i> wrong</span>
          <span><i style="background:var(--sim-kept)"></i> fit through the correct ones</span>
        </p>

        <p class="sim-verdict" data-sim-verdict>
          Do a handful across different angles. One trial is a reaction time; a set of them is a slope.
        </p>
      </div>
    </section>
  </div>

  {/* the action bar changes with the mode; the insight view runs itself */}
  <div class="sim-controls" data-sim-controls></div>
</rotation-sim>

<script>
  import '../../scripts/sims/rotation';
</script>
