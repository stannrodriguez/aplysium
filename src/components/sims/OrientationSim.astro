---
import '../../styles/sim.css';
import '../../styles/sims/orientation.css';

interface Props {
  label?: string;
}

const { label = 'One cell in V1 · cat, anaesthetised' } = Astro.props;
---

<orientation-sim class="sim">
  <div class="sim-chrome">
    <span class="sim-chrome-dot" aria-hidden="true"></span>
    <span class="sim-chrome-label">{label}</span>
    <span class="sim-chrome-status" data-sim-status aria-live="polite">cell 1 · 0 angles tried</span>
  </div>

  <div class="sim-panels">
    <section class="sim-panel">
      <div class="sim-panel-head">
        <h3 class="sim-panel-title">The screen</h3>
        <p class="sim-readout">firing <b data-sim-rate aria-live="polite">—</b></p>
      </div>

      <div class="sim-stage ori-screen-stage" data-sim-screen></div>

      <div class="sim-field">
        <span class="sim-field-label" id="ori-angle-label">Bar angle</span>
        <input
          class="sim-slider"
          type="range"
          min="0"
          max="170"
          value="0"
          step="5"
          data-sim-angle
          aria-labelledby="ori-angle-label"
        />
        <span class="sim-value" data-sim-angle-value>0°</span>
      </div>

      <div class="sim-toggle">
        <span class="sim-toggle-label">What you put on the screen</span>
        <button type="button" class="sim-pill" data-sim-stimulus="bar" aria-pressed="true">a bar of light</button>
        <button type="button" class="sim-pill" data-sim-stimulus="dot" aria-pressed="false">a spot of light</button>
      </div>

      <p class="sim-note" data-sim-screen-note>
        Set an angle and present the bar. The cell has a preference; it will not tell you what it is.
      </p>
    </section>

    <section class="sim-panel">
      <div class="sim-panel-head">
        <h3 class="sim-panel-title">What the electrode heard</h3>
        <p class="sim-readout">3 repeats</p>
      </div>

      <div class="sim-stage ori-raster-stage" data-sim-raster></div>

      <p class="sim-note">
        Hubel and Wiesel worked with an audio monitor. A cell going from a click every half second to
        a burst is unmistakable by ear, which is how the accident got noticed at all.
      </p>
    </section>

    <section class="sim-panel">
      <div class="sim-panel-head">
        <h3 class="sim-panel-title">Tuning curve</h3>
        <p class="sim-readout">spikes / s</p>
      </div>

      <div class="sim-stage ori-tuning-stage" data-sim-tuning></div>

      <p class="sim-verdict" data-sim-verdict>
        Try a few angles. The cell answers to one of them and to almost nothing else.
      </p>
    </section>
  </div>

  <div class="sim-controls">
    <button type="button" class="sim-btn sim-btn-primary" data-sim-present>Present it</button>
    <button type="button" class="sim-btn sim-btn-outline" data-sim-sweep>Sweep every angle</button>
    <button type="button" class="sim-btn sim-btn-quiet" data-sim-next-cell>Next cell</button>
  </div>
</orientation-sim>

<script>
  import '../../scripts/sims/orientation';
</script>
