---
import '../../styles/sim.css';
import '../../styles/sims/iconic.css';

interface Props {
  label?: string;
}

const { label = 'Sperling · whole against partial report' } = Astro.props;
---

<iconic-sim class="sim" data-mode="whole">
  <div class="sim-chrome">
    <span class="sim-chrome-dot" aria-hidden="true"></span>
    <span class="sim-chrome-label">{label}</span>
    <span class="sim-chrome-status" data-sim-status aria-live="polite">whole report</span>
  </div>

  <div class="sim-modes" role="group" aria-label="Choose how you are asked">
    <button type="button" class="sim-mode-tab" data-sim-mode="whole" aria-pressed="true">Whole report</button>
    <button type="button" class="sim-mode-tab" data-sim-mode="partial" aria-pressed="false">Partial report</button>
    <button type="button" class="sim-mode-tab" data-sim-mode="insight" aria-pressed="false">Delay the cue</button>
  </div>

  <div class="sim-panels">
    <section class="sim-panel">
      <p class="sim-lead" data-sim-lead aria-live="polite">
        Whole report. A grid of twelve letters flashes for fifty milliseconds. Then type every letter
        you can still see — all twelve, in any order. Almost everyone lands around four.
      </p>

      {/* the instrument every mode drives: one grid, in one place */}
      <div
        class="sim-stage ico-stage"
        data-sim-display
        role="img"
        aria-label="A blank display, waiting for you to flash the grid."
      >
        <p class="ico-centre">
          Twelve letters, fifty milliseconds. Flash the grid when you are looking at the panel.
        </p>
      </div>

      <p class="sim-note" data-sim-prompt>
        You will be asked for everything you saw.
      </p>

      <div class="ico-answer-row" data-sim-answer-row hidden>
        <input
          class="ico-input"
          type="text"
          maxlength="12"
          autocomplete="off"
          autocapitalize="characters"
          spellcheck="false"
          data-sim-answer
          placeholder="letters, any order"
          aria-label="The letters you saw"
        />
        <button type="button" class="ico-submit" data-sim-submit disabled>Score it</button>
      </div>

      <p class="ico-result" data-sim-trial-result aria-live="polite"></p>

      {/* insight mode only: the multiply-up, the cue delay, and the decay */}
      <div class="ico-insight" data-sim-insight hidden>
        <div class="ico-multiply" data-sim-multiply>
          <p class="sim-note">Flash the grid a few times in this mode to build the estimate.</p>
        </div>

        <div class="sim-field" data-sim-delay-field>
          <span class="sim-field-label" id="ico-delay-label">When the cue arrives</span>
          <input
            class="sim-slider"
            type="range"
            min="0"
            max="1000"
            value="0"
            step="100"
            data-sim-delay
            aria-labelledby="ico-delay-label"
          />
          <span class="sim-value" data-sim-delay-value>immediately</span>
        </div>

        <div class="sim-stage ico-plot-stage" data-sim-plot></div>

        <p class="sim-verdict" data-sim-verdict>
          Flash the grid with the cue immediate, then drag it later and later. Watch the
          letters-available estimate fall back toward four — that fall is the store decaying.
        </p>
      </div>
    </section>
  </div>

  {/* the action bar is rebuilt per mode; here so the panel reads before JS */}
  <div class="sim-controls" data-sim-controls>
    <button type="button" class="sim-btn sim-btn-primary" data-sim-run>Flash the grid</button>
    <button type="button" class="sim-btn sim-btn-quiet" data-sim-reset>Reset</button>
  </div>
</iconic-sim>

<script>
  import '../../scripts/sims/iconic';
</script>
