---
import '../../styles/sim.css';
import '../../styles/sims/iconic.css';

interface Props {
  label?: string;
}

const { label = 'Whole report against partial report' } = Astro.props;
---

<iconic-sim class="sim">
  <div class="sim-chrome">
    <span class="sim-chrome-dot" aria-hidden="true"></span>
    <span class="sim-chrome-label">{label}</span>
    <span class="sim-chrome-status" data-sim-status aria-live="polite">partial report</span>
  </div>

  <div class="sim-panels">
    <section class="sim-panel">
      <div class="sim-panel-head">
        <h3 class="sim-panel-title">The display</h3>
        <p class="sim-readout" data-sim-count>0 trials</p>
      </div>

      <div class="sim-stage ico-stage" data-sim-display>
        <p class="ico-centre">
          Twelve letters, fifty milliseconds. Run a trial when you are looking at the panel.
        </p>
      </div>

      <p class="sim-note" data-sim-prompt>
        You will be asked for one row, and you will not know which one until the grid has gone.
      </p>

      <div class="ico-answer-row" data-sim-answer-row hidden>
        <input
          class="ico-input"
          type="text"
          maxlength="12"
          autocomplete="off"
          autocapitalize="characters"
          spellcheck="false"
          data-sim-answer
          placeholder="letters, any order"
          aria-label="The letters you saw"
        />
        <button type="button" class="ico-submit" data-sim-submit disabled>Score it</button>
      </div>

      <p class="ico-result" data-sim-trial-result aria-live="polite"></p>
    </section>

    <section class="sim-panel">
      <div class="sim-panel-head">
        <h3 class="sim-panel-title">How you are asked</h3>
      </div>

      <div class="sim-choices">
        <button type="button" class="sim-choice" data-sim-mode="partial" aria-pressed="true">
          <b>Partial report</b><em>one row, named after the grid has gone</em>
        </button>
        <button type="button" class="sim-choice" data-sim-mode="whole" aria-pressed="false">
          <b>Whole report</b><em>everything you saw</em>
        </button>
      </div>

      <div class="sim-field" data-sim-delay-field>
        <span class="sim-field-label" id="ico-delay-label">When the cue arrives</span>
        <input
          class="sim-slider"
          type="range"
          min="0"
          max="1000"
          value="0"
          step="100"
          data-sim-delay
          aria-labelledby="ico-delay-label"
        />
        <span class="sim-value" data-sim-delay-value>immediately</span>
      </div>

      <p class="sim-note">
        Sperling used a tone for the cue, so it could not be seen. Here it is a marker beside the
        row — the part that matters is that it comes after the grid has already gone.
      </p>
    </section>

    <section class="sim-panel">
      <div class="sim-panel-head">
        <h3 class="sim-panel-title">Your results</h3>
        <p class="sim-readout">letters available</p>
      </div>

      <div class="sim-stage ico-plot-stage" data-sim-plot></div>

      <p class="sim-verdict" data-sim-verdict>
        Run a few trials of each kind. The point is not what you score — it is the difference between
        the two scores.
      </p>
    </section>
  </div>

  <div class="sim-controls">
    <button type="button" class="sim-btn sim-btn-primary" data-sim-run>Run a trial</button>
    <button type="button" class="sim-btn sim-btn-quiet" data-sim-reset>Reset</button>
  </div>
</iconic-sim>

<script>
  import '../../scripts/sims/iconic';
</script>
