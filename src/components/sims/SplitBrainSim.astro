---
import '../../styles/sim.css';
import '../../styles/sims/splitbrain.css';

interface Props {
  label?: string;
}

const { label = 'Tachistoscope · one item to each hemifield' } = Astro.props;
---

<splitbrain-sim class="sim" data-mode="verbal">
  <div class="sim-chrome">
    <span class="sim-chrome-dot" aria-hidden="true"></span>
    <span class="sim-chrome-label">{label}</span>
    <span class="sim-chrome-status" data-sim-status aria-live="polite">callosum sectioned</span>
  </div>

  <div class="sim-modes" role="group" aria-label="Choose who to ask">
    <button type="button" class="sim-mode-tab" data-sim-mode="verbal" aria-pressed="true">Ask out loud</button>
    <button type="button" class="sim-mode-tab" data-sim-mode="hand" aria-pressed="false">Ask the left hand</button>
    <button type="button" class="sim-mode-tab" data-sim-mode="why" aria-pressed="false">Why did you do that?</button>
  </div>

  <div class="sim-panels">
    <section class="sim-panel">
      <p class="sim-lead" data-sim-lead aria-live="polite">
        Flash the pair, then ask them to say what they saw. The half of the brain that talks is the
        left — and with the callosum cut it only ever received the right hemifield.
      </p>

      <div
        class="sim-stage spl-screen"
        data-sim-screen
        role="img"
        aria-label="A screen split at a fixation cross, one item flashed to each visual hemifield"
      >
        <div class="spl-fix">+</div>
        <p class="spl-hint">
          Eyes on the cross. The flash lasts a tenth of a second — less than it takes to look away.
        </p>
      </div>

      <div class="sim-toggle">
        <span class="sim-toggle-label">Corpus callosum</span>
        <button type="button" class="sim-pill" data-sim-callosum="cut" aria-pressed="true">sectioned</button>
        <button type="button" class="sim-pill" data-sim-callosum="intact" aria-pressed="false">intact</button>
      </div>

      <p class="sim-note">
        Each item lands in one visual hemifield and goes to the opposite hemisphere. The flash is
        shorter than it takes to move an eye, which is what keeps each half of the brain from seeing
        the other half’s item.
      </p>
    </section>

    <section class="sim-panel">
      <div class="sim-panel-head">
        <h3 class="sim-panel-title">On the table</h3>
      </div>

      <div class="spl-cards" data-sim-cards></div>

      <div class="spl-answer" data-sim-said hidden>
        <span class="spl-answer-who">What they say<br />left hemisphere</span>
        <span class="spl-answer-what" data-sim-said-text></span>
      </div>

      <div class="spl-answer" data-sim-did hidden>
        <span class="spl-answer-who">What the left hand does<br />right hemisphere</span>
        <span class="spl-answer-what" data-sim-did-text></span>
      </div>

      <div class="spl-answer spl-why" data-sim-why-answer hidden>
        <span class="spl-answer-who">Why they say they did it<br />immediate, unhesitating</span>
        <span class="spl-answer-what" data-sim-why-text></span>
      </div>

      <p class="sim-verdict" data-sim-verdict>
        Two items, one to each hemifield, and a flash too short to look at both. Each half of the
        brain gets a different trial.
      </p>
    </section>
  </div>

  {/* the action bar is rebuilt per mode by the script; these are the pre-JS defaults */}
  <div class="sim-controls" data-sim-controls>
    <button type="button" class="sim-btn sim-btn-primary" data-sim-flash>Flash, then ask out loud</button>
    <button type="button" class="sim-btn sim-btn-quiet" data-sim-next>New pair</button>
  </div>
</splitbrain-sim>

<script>
  import '../../scripts/sims/splitbrain';
</script>
