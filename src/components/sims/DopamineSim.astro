---
import '../../styles/sim.css';
import '../../styles/sims/dopamine.css';

interface Props {
  label?: string;
}

const { label = 'One midbrain dopamine cell · monkey' } = Astro.props;
---

<dopamine-sim class="sim" data-mode="unexpected">
  <div class="sim-chrome">
    <span class="sim-chrome-dot" aria-hidden="true"></span>
    <span class="sim-chrome-label">{label}</span>
    <span class="sim-chrome-status" data-sim-status aria-live="polite">V = 0.00 · 0 trials</span>
  </div>

  <div class="sim-modes" role="group" aria-label="Choose which trial to watch">
    <button type="button" class="sim-mode-tab" data-sim-mode="unexpected" aria-pressed="true">Unexpected</button>
    <button type="button" class="sim-mode-tab" data-sim-mode="predicted" aria-pressed="false">Predicted</button>
    <button type="button" class="sim-mode-tab" data-sim-mode="omission" aria-pressed="false">Omission</button>
    <button type="button" class="sim-mode-tab" data-sim-mode="insight" aria-pressed="false">Prediction&nbsp;error</button>
  </div>

  <div class="sim-panels">
    <section class="sim-panel">
      <p class="sim-lead" data-sim-lead aria-live="polite">
        A reward out of nowhere. Deliver juice with no warning cue and watch the cell — an
        unpredicted reward should produce a burst as big as the surprise.
      </p>

      {/* ── the experiment: one dopamine cell across one trial ── */}
      <div data-sim-experiment>
        <div class="sim-panel-head">
          <h3 class="sim-panel-title">One trial · the cell's firing</h3>
          <p class="sim-readout">error at reward <b data-sim-delta aria-live="polite">—</b></p>
        </div>

        <div class="sim-stage dop-trace-stage" data-sim-trace>
          <svg class="dop-svg" viewBox="0 0 320 148" role="img" aria-label="The cell at its resting rate, with nothing presented yet.">
            <line class="dop-base" x1="30" y1="104" x2="308" y2="104"></line>
            <text class="dop-tick" x="25" y="107" text-anchor="end">base</text>
            <text class="dop-tick" x="160" y="74" text-anchor="middle">run a trial and watch where the burst goes</text>
          </svg>
        </div>

        <div class="dop-v">
          <span class="dop-v-label">Cue predicts reward</span>
          <span class="dop-v-track"><i data-sim-v-bar></i></span>
          <span class="dop-v-value" data-sim-v>0.00</span>
        </div>

        <div class="sim-panel-head">
          <h3 class="sim-panel-title">Error at the moment of reward · every trial</h3>
        </div>

        <div class="sim-stage dop-history-stage" data-sim-history>
          <svg class="dop-svg" viewBox="0 0 320 92" role="img" aria-label="No trials yet.">
            <line class="dop-base" x1="8" y1="40" x2="312" y2="40"></line>
            <text class="dop-tick" x="160" y="32" text-anchor="middle">error at the moment of reward</text>
          </svg>
        </div>
      </div>

      {/* ── the insight: it is prediction error, and the dip is decisive ── */}
      <div data-sim-insight hidden>
        <p class="sim-note">
          The three canonical trials side by side. Every response is the same one quantity — the
          prediction error δ, what you got minus what you expected — computed by the model.
        </p>

        <div class="dop-ins-traces">
          <figure class="dop-ins">
            <figcaption class="dop-ins-cap">Unexpected reward</figcaption>
            <div class="sim-stage dop-ins-stage" data-sim-ins-surprise></div>
            <p class="dop-ins-delta" data-sim-ins-surprise-d></p>
          </figure>
          <figure class="dop-ins">
            <figcaption class="dop-ins-cap">Predicted reward</figcaption>
            <div class="sim-stage dop-ins-stage" data-sim-ins-paired></div>
            <p class="dop-ins-delta" data-sim-ins-paired-d></p>
          </figure>
          <figure class="dop-ins">
            <figcaption class="dop-ins-cap">Reward omitted</figcaption>
            <div class="sim-stage dop-ins-stage" data-sim-ins-omitted></div>
            <p class="dop-ins-delta" data-sim-ins-omitted-d></p>
          </figure>
        </div>

        <p class="sim-verdict" data-sim-insight-verdict></p>
      </div>
    </section>
  </div>

  {/* the action bar changes with the mode; the insight mode reads itself */}
  <div class="sim-controls" data-sim-controls></div>
</dopamine-sim>

<script>
  import '../../scripts/sims/dopamine';
</script>
