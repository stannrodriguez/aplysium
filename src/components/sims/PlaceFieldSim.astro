---
import '../../styles/sim.css';
import '../../styles/sims/placefield.css';

interface Props {
  label?: string;
}

const { label = 'One hippocampal cell · rat, freely moving' } = Astro.props;

// The arena is server-rendered in its resting state — a bare box, the cue card
// on the top wall, the animal in the middle, no spikes yet — so the panel reads
// as the experiment before any script runs. The behaviour script redraws it on
// every move.
---

<placefield-sim class="sim" data-mode="forage">
  <div class="sim-chrome">
    <span class="sim-chrome-dot" aria-hidden="true"></span>
    <span class="sim-chrome-label">{label}</span>
    <span class="sim-chrome-status" data-sim-status aria-live="polite">one cell, one place</span>
  </div>

  <div class="sim-modes" role="group" aria-label="Choose what to watch">
    <button type="button" class="sim-mode-tab" data-sim-mode="forage" aria-pressed="true">Forage</button>
    <button type="button" class="sim-mode-tab" data-sim-mode="cell" aria-pressed="false">Another cell</button>
    <button type="button" class="sim-mode-tab" data-sim-mode="insight" aria-pressed="false">Codes place</button>
  </div>

  <div class="sim-panels">
    <section class="sim-panel">
      <p class="sim-lead" data-sim-lead aria-live="polite">
        Drop the animal in a bare box and let it wander. Each time this one cell fires, mark where the
        animal was standing — nowhere else. The marks pile up in a single patch: that patch is the
        cell&#8217;s place field.
      </p>

      <div class="sim-panel-head">
        <h3 class="sim-panel-title">The arena, from above</h3>
        <p class="sim-readout">firing <b data-sim-rate aria-live="polite">0 /s</b></p>
      </div>

      <div class="sim-stage pf-arena" data-sim-arena>
        <svg class="pf-svg" viewBox="0 0 260 200" role="img" xmlns="http://www.w3.org/2000/svg"
             aria-label="The arena from above. 0 spikes marked where the animal was standing when cell 1 fired.">
          <rect class="pf-floor" x="1" y="1" width="258" height="198"/>
          <rect class="pf-cue" x="108" y="6" width="44" height="6"/>
          <circle class="pf-rat" cx="130" cy="100" r="5"/>
        </svg>
      </div>

      <p class="sim-key pf-legend">
        <span><i style="background:var(--sim-signal)"></i> a spike, where it happened</span>
        <span><i style="background:var(--meta-faint)"></i> where the animal went</span>
        <span><i style="background:var(--sim-tissue)"></i> cue card</span>
      </p>

      <p class="sim-readout pf-metrics">
        <span data-sim-count>cell 1 &#183; 0 spikes</span>
        <span>floor covered <b data-sim-coverage>0%</b></span>
      </p>

      <p class="sim-note" data-sim-note>
        Click anywhere in the box to walk the animal there, or let it forage and cover the floor on
        its own.
      </p>

      <p class="sim-verdict" data-sim-verdict>
        A spike train alone is a list of times. Plotting each spike where the animal was standing is
        what turns it into a map &#8212; so cover some ground first.
      </p>
    </section>
  </div>

  {/* the action bar changes with the mode; the script rebuilds it */}
  <div class="sim-controls" data-sim-controls></div>
</placefield-sim>

<script>
  import '../../scripts/sims/placefield';
</script>
