---
/**
 * The experiment a study pins in its right-hand column, chosen by key.
 *
 * Each island is a framework-free custom element whose markup is rendered here
 * on the server, so the panel reads before — and without — JavaScript. Adding
 * one is three edits: a key on `SimulatorKey`, a component in this map, and a
 * caption in `src/data/sims.ts`.
 */
import AplysiaSim from './sims/AplysiaSim.astro';
import AxonSim from './sims/AxonSim.astro';
import CajalSim from './sims/CajalSim.astro';
import RetinaSim from './sims/RetinaSim.astro';
import HomunculusSim from './sims/HomunculusSim.astro';
import IconicSim from './sims/IconicSim.astro';
import OrientationSim from './sims/OrientationSim.astro';
import SplitBrainSim from './sims/SplitBrainSim.astro';
import PlaceFieldSim from './sims/PlaceFieldSim.astro';
import RotationSim from './sims/RotationSim.astro';
import ReplaySim from './sims/ReplaySim.astro';
import DopamineSim from './sims/DopamineSim.astro';
import GorillaSim from './sims/GorillaSim.astro';
import GridSim from './sims/GridSim.astro';
import type { SimulatorKey } from '../data/types';

interface Props {
  kind: SimulatorKey;
}

const { kind } = Astro.props;

// Astro components have per-component prop types, so the map is deliberately
// loose; the exhaustive `SimulatorKey` key is what keeps it honest.
const SIMS: Record<SimulatorKey, any> = {
  aplysia: AplysiaSim,
  cajal: CajalSim,
  axon: AxonSim,
  retina: RetinaSim,
  homunculus: HomunculusSim,
  iconic: IconicSim,
  orientation: OrientationSim,
  splitbrain: SplitBrainSim,
  placefield: PlaceFieldSim,
  rotation: RotationSim,
  replay: ReplaySim,
  dopamine: DopamineSim,
  gorilla: GorillaSim,
  grid: GridSim,
};

const Sim = SIMS[kind];
---

<Sim />
