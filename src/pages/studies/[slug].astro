---
import Base from '../../layouts/Base.astro';
import LayerList from '../../components/LayerList.astro';
import StatusDot from '../../components/StatusDot.astro';
import AplysiaSim from '../../components/AplysiaSim.astro';
import { studies } from '../../data/studies';
import { entryFor } from '../../lib/entry';
import { ENTRY_STATUS_LINE } from '../../data/types';
import type { Study } from '../../data/types';

export function getStaticPaths() {
  return studies.map(study => ({ params: { slug: study.slug }, props: { study } }));
}

interface Props {
  study: Study;
}

const { study } = Astro.props;
const { dive } = entryFor(study);
const metaYear = dive.metaYear ?? study.year;
const statusLine = ENTRY_STATUS_LINE[study.status];
const hasSim = study.simulator === 'aplysia';
// The right-hand column exists for the instrument, or for a note about the one
// this study is still waiting on.
const twoColumn = hasSim || study.hasDemo;
---

<Base title={`${study.claim} — ${study.author}`} description={dive.bridge}>
  <main class="entry" data-two-column={twoColumn ? 'true' : 'false'}>
    <header class="hero">
      <p class="meta">
        <span>{study.author}</span>
        <span>{study.subject}</span>
        <span>{metaYear}</span>
      </p>
      <h1 class="claim">{study.claim}</h1>
      <p class="bridge">{dive.bridge}</p>
      <div class="status-row">
        <span class="status">
          <StatusDot status={study.status} variant="entry" labelled={false} />
          {statusLine}
        </span>
        <button type="button" class="expand" data-expand-all aria-expanded="false">expand all</button>
      </div>
    </header>

    <div class="body">
      <div class="reading">
        <div class="reading-bar">
          <span class="reading-bar-label">Read it in layers</span>
          <button type="button" class="expand expand-sm" data-expand-all aria-expanded="false">expand all</button>
        </div>
        <LayerList layers={dive.layers} />
      </div>

      {hasSim && (
        <aside class="sim-col">
          <p class="sim-col-label">The experiment</p>
          <AplysiaSim show="animal,synapse,trace,longterm" />
          {dive.simCaption && <p class="sim-col-caption">{dive.simCaption}</p>}
        </aside>
      )}

      {!hasSim && study.hasDemo && (
        <aside class="sim-col">
          <p class="sim-col-label">The experiment</p>
          <div class="sim-pending">
            <p>
              Not built yet. The worked example is
              <a href="/studies/kandel-aplysia/">Kandel's gill-withdrawal reflex</a>, where you can run
              the training yourself.
            </p>
          </div>
        </aside>
      )}
    </div>

    <footer class="entry-foot">
      <a href="/">← all twenty studies</a>
    </footer>
  </main>
</Base>

<style>
  .entry {
    max-width: 1280px;
    margin: 0 auto;
    padding: 48px 40px 60px;
    color: var(--ink);
  }

  /* hero ------------------------------------------------------------------ */
  .hero {
    padding-bottom: 26px;
    border-bottom: 2px solid var(--ink);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--meta);
  }

  .claim {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 48px;
    line-height: 1.08;
    letter-spacing: -.02em;
    margin-top: 16px;
    max-width: 24ch;
    text-wrap: pretty;
  }

  .bridge {
    font-family: var(--serif);
    font-size: 19px;
    line-height: 1.55;
    color: var(--body);
    margin-top: 18px;
    max-width: 70ch;
    text-wrap: pretty;
  }

  .status-row {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 20px;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .04em;
    color: var(--muted);
  }

  .expand {
    margin-left: auto;
    cursor: pointer;
    border: 1px solid var(--ink);
    background: transparent;
    padding: 11px 16px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .expand:hover { background: var(--ink); color: var(--paper); }

  /* two columns ----------------------------------------------------------- */
  .body {
    display: grid;
    grid-template-columns: 1fr 470px;
    gap: 44px;
    align-items: start;
    margin-top: 8px;
  }

  .entry[data-two-column='false'] .body { grid-template-columns: minmax(0, 1fr); }

  .reading { min-width: 0; }

  /* the "read it in layers" rule is a mobile-only device */
  .reading-bar { display: none; }
  .expand-sm { display: none; }

  .sim-col {
    position: sticky;
    top: 16px;
  }

  /* The panel itself takes the scroll, so its label and caption — and the
     control bar pinned inside it — stay on screen at any viewport height. */
  .sim-col :global(.sim) {
    max-height: calc(100vh - 140px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .sim-col-label,
  .sim-col-caption {
    text-wrap: pretty;
  }

  .sim-col-label {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--meta);
    margin-bottom: 10px;
  }

  .sim-col-caption {
    font-size: 13px;
    line-height: 1.55;
    color: var(--muted);
    margin-top: 10px;
  }

  .sim-pending {
    border: 1px solid var(--hairline-entry);
    padding: 18px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--muted);
    text-wrap: pretty;
  }

  .entry-foot {
    margin-top: 40px;
    padding-top: 18px;
    border-top: 1px solid var(--hairline-entry);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .entry-foot a { text-decoration: none; }
  .entry-foot a:hover { text-decoration: underline; }

  /* ── mobile: its own order — claim, then the instrument, then the layers ─ */
  @media (max-width: 899px) {
    .entry { padding: 24px 20px 44px; }

    .hero { border-bottom: 0; padding-bottom: 0; }
    .meta { gap: 10px; font-size: 10px; letter-spacing: .14em; }
    .claim { font-size: 33px; margin-top: 10px; max-width: none; }
    .bridge { font-size: 16.5px; margin-top: 14px; }

    .status-row { margin-top: 14px; }
    .status { font-size: 10.5px; }
    .hero .expand { display: none; }

    .body {
      display: flex;
      flex-direction: column;
      gap: 0;
      margin-top: 0;
    }

    .sim-col {
      order: -1;
      position: static;
      margin-top: 20px;
    }

    .sim-col :global(.sim) {
      max-height: none;
      overflow: visible;
    }

    .sim-col-label { font-size: 10px; margin-bottom: 9px; }

    /* the caption points at the desktop two-column reading; drop it here */
    .sim-col-caption { display: none; }

    .reading-bar {
      display: flex;
      align-items: baseline;
      gap: 10px;
      margin-top: 26px;
      padding-bottom: 10px;
      border-bottom: 2px solid var(--ink);
    }

    .reading-bar-label {
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--meta);
    }

    .expand-sm {
      display: block;
      padding: 8px 12px;
      font-size: 10px;
    }
  }
</style>
